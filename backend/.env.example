# Copy this file to .env and adjust if needed. Defaults match docker-compose.yml.

# --- Database ---
DATABASE_URL="postgresql://fyp:fyp_dev_password@localhost:5432/fyp_network?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
JWT_REFRESH_EXPIRES_IN="30d"

# --- App ---
PORT=3000
# Base URL the API is reachable at, used to build absolute media URLs
API_BASE_URL="http://localhost:3000"

# --- MinIO (S3-compatible local object storage) ---
# S3_ENDPOINT is what the BACKEND uses to talk to MinIO - correct as localhost
# since both run on your machine. S3_PUBLIC_ENDPOINT is what gets embedded in
# image URLs sent back to clients, which is a different thing: the Android
# emulator's "localhost" refers to the emulator itself, not your machine, so
# it needs the 10.0.2.2 alias instead. A physical device would need your
# machine's LAN IP here instead (same as API_BASE_URL's equivalent case).
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_ENDPOINT="http://10.0.2.2:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="fyp_minio_admin"
S3_SECRET_KEY="fyp_minio_password"
S3_BUCKET="fyp-media"
S3_FORCE_PATH_STYLE=true
